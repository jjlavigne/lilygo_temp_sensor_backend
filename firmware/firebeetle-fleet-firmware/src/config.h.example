// Copy to config.h and fill in. config.h is gitignored in this project -- the
// LilyGO project's config.h was committed by mistake and its credentials are in
// git history, which is why this one stays out from the start.

#ifndef CONFIG_H
#define CONFIG_H

// --- WiFi ---
// The FireBeetle, like every ESP32, is 2.4 GHz only. It cannot see a 5 GHz network.
const char* WIFI_SSID = "";
const char* WIFI_PASS = "";

// --- Broker ---
// The VM's IP address ON THE NETWORK THIS BOARD JOINS. This changes when the VM
// moves networks, and a wrong value here looks exactly like a dead device: the
// board joins WiFi fine and then times out connecting. Check it before flashing.
const char* MQTT_BROKER = "10.80.149.11";
const int   MQTT_PORT   = 1883;
const char* MQTT_TOPIC  = "fleet/telemetry";

// Must match mosquitto/pwfile. The broker runs allow_anonymous false, so a board
// without these is rejected with client state 4 or 5.
const char* MQTT_USER   = "";
const char* MQTT_PASS   = "";

// --- Identity ---
// Must exactly match the device_id registered in the admin UI at :8080, or the
// readings are stored but belong to no company and appear on no dashboard.
//
// ⚠️ This is also the join key for every row this board has ever written.
// Changing it ORPHANS that history. To relabel a unit, change DISPLAY_NAME
// below (and devices.display_name in the admin UI) -- never this.
const char* DEVICE_ID   = "PLY-CHILL-02";

// What the OLED prints along the top. Screen only: never published, nothing
// joins on it, safe to change whenever. Keep it matching devices.display_name
// so the board and the dashboard call the unit the same thing.
const char* DISPLAY_NAME = "DOCK-DOOR-01";

// --- Optional: site coordinates for the fleet map ---
// The facility location, not a GPS fix. Comment out to omit from the payload.
#define SITE_LAT 47.3073        // Auburn WA
#define SITE_LON -122.2285

// --- Optional: advisory limits for the local display only ---
// The authoritative limits live in the devices table and are what actually
// alert. These exist so somebody walking past can read OK/HIGH/LOW without
// opening a dashboard. If they ever disagree, the database is right -- so keep
// them in step, or comment them out and let the screen show only a temperature.
#define DISPLAY_TEMP_MIN_F 26.6
#define DISPLAY_TEMP_MAX_F 33.8

#endif
