.env

# Volume backups (large binaries, regenerate with docker run ... tar czf)
*.tar.gz

# PlatformIO build output (37 MB of compiled artifacts, regenerated on every build)
.pio/
**/.pio/

# Python
__pycache__/
*.pyc

# Claude Code local machine settings
.claude/settings.local.json

