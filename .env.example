# Copy to .env and fill in. .env is gitignored: it holds every secret the stack
# needs, and none of them are recoverable from this repository.
#
#   cp .env.example .env    then edit
#
# docker-compose.yml reads these directly. The defaults baked into the compose
# file are development throwaways -- set real values here before anything ships.

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fleet_data

# The read-only role Grafana connects as. Created by hand, not by compose --
# RESTORE.md has the CREATE ROLE and GRANT statements.
GRAFANA_VIEWER_PASSWORD=change-me

# --- Device admin UI (port 8080) ----------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Flask session signing key. Any long random string; changing it logs everyone out.
ADMIN_SECRET_KEY=change-me

# --- Grafana service account token --------------------------------------------
# Only needed for scripted dashboard/alert edits, not for Grafana to run.
# Create at: Administration > Service accounts > Add service account token.
GRAFANA_TOKEN=

# --- Simulator ----------------------------------------------------------------
# Seconds between publishes for the 20 simulated sensors.
PUBLISH_INTERVAL_S=300
# demo | healthy | chaos | showcase   (see CLAUDE.md)
SCENARIO=demo

# --- NOT stored here, and NOT recoverable from git ------------------------------
# The Slack webhook URL. Grafana encrypts it inside grafana.db and will not read
# it back, so it cannot be exported. Keep a copy wherever you keep passwords, or
# be prepared to regenerate it in Slack. RESTORE.md step 6.
