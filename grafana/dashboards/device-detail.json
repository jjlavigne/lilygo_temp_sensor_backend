      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH flagged AS (\n  SELECT t.recorded_at, t.temperature_c, d.temp_min_c, d.temp_max_c,\n         d.expected_interval_s,\n         (t.temperature_c > d.temp_max_c OR t.temperature_c < d.temp_min_c) AS bad\n  FROM telemetry t\n  JOIN devices d ON d.device_id = t.device_id\n  WHERE COALESCE(d.display_name, d.device_id) = ${device:sqlstring} AND t.recorded_at > now() - interval '$window'\n),\nedges AS (\n  SELECT *, LAG(bad) OVER (ORDER BY recorded_at) AS prev_bad FROM flagged\n),\nruns AS (\n  SELECT *, SUM(CASE WHEN bad IS DISTINCT FROM prev_bad THEN 1 ELSE 0 END)\n              OVER (ORDER BY recorded_at) AS run_id\n  FROM edges\n)\nSELECT\n  min(recorded_at) AS started,\n  EXTRACT(EPOCH FROM (max(recorded_at) - min(recorded_at))) + max(expected_interval_s) AS duration,\n  CASE WHEN max(temperature_c) > max(temp_max_c) THEN 'TOO WARM' ELSE 'TOO COLD' END AS kind,\n  max(GREATEST(temperature_c - temp_max_c, temp_min_c - temperature_c)) * 9.0/5.0 AS worst_by,\n  count(*) AS readings\nFROM runs\nWHERE bad\nGROUP BY run_id\nORDER BY started DESC",
          "refId": "A"
        }
      ],
      "title": "Excursions \u2014 last $window",
      "type": "table"
