{
  "uid": "device-detail",
  "title": "Device Detail",
  "tags": [
    "fleet",
    "cold-chain"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "10s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "cfmk49pm86epsf"
        },
        "query": "SELECT COALESCE(display_name, device_id) FROM devices ORDER BY 1;",
        "multi": false,
        "includeAll": false,
        "refresh": 1,
        "current": {},
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Current Temperature",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cfmk49pm86epsf"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.temperature_c * 9.0/5.0 + 32 AS temperature FROM devices d\nLEFT JOIN LATERAL (\n  SELECT temperature_c, battery_pct, recorded_at\n  FROM telemetry WHERE device_id = d.device_id\n  ORDER BY recorded_at DESC LIMIT 1\n) t ON true\nWHERE COALESCE(d.display_name, d.device_id) = ${device:sqlstring}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Status",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cfmk49pm86epsf"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE\n    WHEN t.recorded_at IS NULL THEN 'NEVER SEEN'\n    WHEN t.recorded_at < now() - (GREATEST(d.expected_interval_s * 3, 60) || ' seconds')::interval\n      THEN 'OFFLINE'\n    WHEN t.temperature_c > d.temp_max_c THEN 'HIGH'\n    WHEN t.temperature_c < d.temp_min_c THEN 'LOW'\n    ELSE 'OK' END AS status\nFROM devices d\nLEFT JOIN LATERAL (\n  SELECT temperature_c, battery_pct, recorded_at\n  FROM telemetry WHERE device_id = d.device_id\n  ORDER BY recorded_at DESC LIMIT 1\n) t ON true\nWHERE COALESCE(d.display_name, d.device_id) = ${device:sqlstring}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "OK": {
                  "color": "green",
                  "index": 0
                },
                "HIGH": {
                  "color": "red",
                  "index": 1
                },
                "LOW": {
                  "color": "blue",
                  "index": 2
                },
                "OFFLINE": {
                  "color": "orange",
                  "index": 3
                },
                "NEVER SEEN": {
                  "color": "purple",
                  "index": 4
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Battery",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cfmk49pm86epsf"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.battery_pct FROM devices d\nLEFT JOIN LATERAL (\n  SELECT temperature_c, battery_pct, recorded_at\n  FROM telemetry WHERE device_id = d.device_id\n  ORDER BY recorded_at DESC LIMIT 1\n) t ON true\nWHERE COALESCE(d.display_name, d.device_id) = ${device:sqlstring}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Last Reading",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cfmk49pm86epsf"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.recorded_at AS last_seen FROM devices d\nLEFT JOIN LATERAL (\n  SELECT temperature_c, battery_pct, recorded_at\n  FROM telemetry WHERE device_id = d.device_id\n  ORDER BY recorded_at DESC LIMIT 1\n) t ON true\nWHERE COALESCE(d.display_name, d.device_id) = ${device:sqlstring}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Temperature vs Safe Range",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cfmk49pm86epsf"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  t.recorded_at AS \"time\",\n  t.temperature_c * 9.0/5.0 + 32 AS \"Temperature\",\n  d.temp_max_c * 9.0/5.0 + 32    AS \"Max safe\",\n  d.temp_min_c * 9.0/5.0 + 32    AS \"Min safe\"\nFROM telemetry t\nJOIN devices d USING (device_id)\nWHERE $__timeFilter(t.recorded_at) AND COALESCE(d.display_name, d.device_id) = ${device:sqlstring}\nORDER BY t.recorded_at",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(Max safe|Min safe)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Dashed red lines are this device's company limits. Anything outside them is an excursion."
    },
    {
      "id": 6,
      "title": "Battery Trend",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cfmk49pm86epsf"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT t.recorded_at AS \"time\", t.battery_pct AS \"Battery\"\nFROM telemetry t JOIN devices d USING (device_id)\nWHERE $__timeFilter(t.recorded_at) AND COALESCE(d.display_name, d.device_id) = ${device:sqlstring} AND t.battery_pct IS NOT NULL\nORDER BY t.recorded_at",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "title": "Rejected Readings",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cfmk49pm86epsf"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.received_at AS \"time\", r.reason, r.raw_payload\nFROM rejected_readings r\nJOIN devices d ON d.device_id = r.device_id\nWHERE $__timeFilter(r.received_at) AND COALESCE(d.display_name, d.device_id) = ${device:sqlstring}\nORDER BY r.received_at DESC LIMIT 50",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "Readings this device sent that were physically impossible, e.g. -127 C from a disconnected probe. Empty is good."
    },
    {
      "id": 8,
      "title": "Recent Readings",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cfmk49pm86epsf"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  t.recorded_at AS \"time\",\n  t.temperature_c * 9.0/5.0 + 32 AS temperature_f,\n  t.battery_pct,\n  t.latitude,\n  t.longitude\nFROM telemetry t JOIN devices d USING (device_id)\nWHERE COALESCE(d.display_name, d.device_id) = ${device:sqlstring}\nORDER BY t.recorded_at DESC LIMIT 100",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "temperature_f"
            },
            "properties": [
              {
                "id": "unit",
                "value": "fahrenheit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "battery_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}