    {
      "id": 5,
      "title": "Temperature \u2014 units at this site",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cfmk49pm86epsf"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 10
      },
      "description": "One line per unit. A site holds a handful of units, so individual lines stay readable here where they would not at fleet scale -- and an average would hide a single unit failing.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(t.recorded_at, $__interval),\n  COALESCE(d.display_name, d.device_id) AS metric,\n  avg(t.temperature_c*9.0/5.0+32) AS temperature\nFROM telemetry t JOIN devices d ON d.device_id = t.device_id AND d.is_active\nWHERE $__timeFilter(t.recorded_at) AND d.site IN (${site:sqlstring}) AND d.company IN (${company:sqlstring})\nGROUP BY 1,2 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 4,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
