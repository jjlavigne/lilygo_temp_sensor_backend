{
  "uid": "site-view",
  "title": "Site View",
  "tags": [
    "fleet",
    "cold-chain"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "location",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "cfmk49pm86epsf"
        },
        "query": "SELECT DISTINCT company || ' / ' || site FROM devices ORDER BY 1;",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "$location",
      "collapsed": true,
      "repeat": "location",
      "repeatDirection": "v",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 101,
          "title": "Units at Site",
          "type": "stat",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "gridPos": {
            "x": 0,
            "y": 1,
            "w": 4,
            "h": 4
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "cfmk49pm86epsf"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT count(*) AS units FROM devices d WHERE d.company || ' / ' || d.site = ${location:sqlstring}",
              "editorMode": "code"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "none",
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "text",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "textMode": "auto",
            "colorMode": "background",
            "graphMode": "none"
          }
        },
        {
          "id": 102,
          "title": "Out of Range",
          "type": "stat",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "gridPos": {
            "x": 4,
            "y": 1,
            "w": 4,
            "h": 4
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "cfmk49pm86epsf"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT count(*) AS n FROM devices d\nLEFT JOIN LATERAL (\n  SELECT temperature_c, battery_pct, recorded_at\n  FROM telemetry WHERE device_id = d.device_id\n  ORDER BY recorded_at DESC LIMIT 1\n) t ON true\nWHERE d.company || ' / ' || d.site = ${location:sqlstring} AND t.recorded_at IS NOT NULL AND NOT (t.recorded_at < now() - (GREATEST(d.expected_interval_s * 3, 60) || ' seconds')::interval)\n  AND (t.temperature_c > d.temp_max_c OR t.temperature_c < d.temp_min_c)",
              "editorMode": "code"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "none",
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "red",
                    "value": 1
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "textMode": "auto",
            "colorMode": "background",
            "graphMode": "none"
          }
        },
        {
          "id": 103,
          "title": "Offline",
          "type": "stat",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "gridPos": {
            "x": 8,
            "y": 1,
            "w": 4,
            "h": 4
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "cfmk49pm86epsf"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT count(*) AS n FROM devices d\nLEFT JOIN LATERAL (\n  SELECT temperature_c, battery_pct, recorded_at\n  FROM telemetry WHERE device_id = d.device_id\n  ORDER BY recorded_at DESC LIMIT 1\n) t ON true\nWHERE d.company || ' / ' || d.site = ${location:sqlstring} AND (t.recorded_at IS NULL OR t.recorded_at < now() - (GREATEST(d.expected_interval_s * 3, 60) || ' seconds')::interval)",
              "editorMode": "code"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "none",
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "orange",
                    "value": 1
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "textMode": "auto",
            "colorMode": "background",
            "graphMode": "none"
          }
        },
        {
          "id": 104,
          "title": "Lowest Battery",
          "type": "stat",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "gridPos": {
            "x": 12,
            "y": 1,
            "w": 4,
            "h": 4
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "cfmk49pm86epsf"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT min(t.battery_pct) AS n FROM devices d\nLEFT JOIN LATERAL (\n  SELECT temperature_c, battery_pct, recorded_at\n  FROM telemetry WHERE device_id = d.device_id\n  ORDER BY recorded_at DESC LIMIT 1\n) t ON true WHERE d.company || ' / ' || d.site = ${location:sqlstring}",
              "editorMode": "code"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "red",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 20
                  },
                  {
                    "color": "green",
                    "value": 50
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "textMode": "auto",
            "colorMode": "background",
            "graphMode": "none"
          }
        },
        {
          "id": 105,
          "title": "Safe Range",
          "type": "stat",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "gridPos": {
            "x": 16,
            "y": 1,
            "w": 8,
            "h": 4
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "cfmk49pm86epsf"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT DISTINCT round((d.temp_min_c * 9.0/5.0 + 32)::numeric,1) || ' - ' ||\n       round((d.temp_max_c * 9.0/5.0 + 32)::numeric,1) AS band\nFROM devices d WHERE d.company || ' / ' || d.site = ${location:sqlstring}",
              "editorMode": "code"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "none",
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "text",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "/.*/",
              "values": false
            },
            "textMode": "auto",
            "colorMode": "none",
            "graphMode": "none"
          },
          "description": "Degrees Fahrenheit. Set per company by cargo type."
        },
        {
          "id": 106,
          "title": "Devices",
          "type": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "gridPos": {
            "x": 0,
            "y": 5,
            "w": 24,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "cfmk49pm86epsf"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT\n  COALESCE(d.display_name, d.device_id) AS device_id,\n  t.temperature_c * 9.0/5.0 + 32 AS temperature,\n  t.battery_pct,\n  t.recorded_at AS last_seen,\n  CASE\n    WHEN t.recorded_at IS NULL THEN 'NEVER SEEN'\n    WHEN t.recorded_at < now() - (GREATEST(d.expected_interval_s * 3, 60) || ' seconds')::interval THEN 'OFFLINE'\n    WHEN t.temperature_c > d.temp_max_c THEN 'HIGH'\n    WHEN t.temperature_c < d.temp_min_c THEN 'LOW'\n    ELSE 'OK'\n  END AS status\nFROM devices d\nLEFT JOIN LATERAL (\n  SELECT temperature_c, battery_pct, recorded_at\n  FROM telemetry WHERE device_id = d.device_id\n  ORDER BY recorded_at DESC LIMIT 1\n) t ON true\nWHERE d.company || ' / ' || d.site = ${location:sqlstring}\nORDER BY COALESCE(d.display_name, d.device_id)",
              "editorMode": "code"
            }
          ],
          "fieldConfig": {
            "defaults": {},
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "status"
                },
                "properties": [
                  {
                    "id": "custom.cellOptions",
                    "value": {
                      "type": "color-background"
                    }
                  },
                  {
                    "id": "mappings",
                    "value": [
                      {
                        "type": "value",
                        "options": {
                          "OK": {
                            "color": "green",
                            "index": 0
                          },
                          "HIGH": {
                            "color": "red",
                            "index": 1
                          },
                          "LOW": {
                            "color": "blue",
                            "index": 2
                          },
                          "OFFLINE": {
                            "color": "orange",
                            "index": 3
                          },
                          "NEVER SEEN": {
                            "color": "purple",
                            "index": 4
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "device_id"
                },
                "properties": [
                  {
                    "id": "links",
                    "value": [
                      {
                        "title": "Open device detail",
                        "url": "/d/device-detail/device-detail?var-device=${__value.raw}&${__url_time_range}"
                      }
                    ]
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "temperature"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "fahrenheit"
                  },
                  {
                    "id": "decimals",
                    "value": 1
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "battery_pct"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "percent"
                  },
                  {
                    "id": "custom.cellOptions",
                    "value": {
                      "type": "gauge",
                      "mode": "gradient"
                    }
                  },
                  {
                    "id": "min",
                    "value": 0
                  },
                  {
                    "id": "max",
                    "value": 100
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "last_seen"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "dateTimeFromNow"
                  }
                ]
              }
            ]
          },
          "options": {
            "showHeader": true,
            "sortBy": [
              {
                "displayName": "status",
                "desc": false
              }
            ]
          },
          "description": "Click a device name to open its full history."
        },
        {
          "id": 107,
          "title": "Temperature",
          "type": "timeseries",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "gridPos": {
            "x": 0,
            "y": 13,
            "w": 24,
            "h": 9
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "cfmk49pm86epsf"
              },
              "format": "time_series",
              "rawQuery": true,
              "rawSql": "SELECT\n  $__timeGroupAlias(t.recorded_at, $__interval),\n  COALESCE(d.display_name, t.device_id) AS metric,\n  avg(t.temperature_c * 9.0/5.0 + 32) AS temperature\nFROM telemetry t JOIN devices d USING (device_id)\nWHERE $__timeFilter(t.recorded_at) AND d.company || ' / ' || d.site = ${location:sqlstring}\nGROUP BY 1, 2 ORDER BY 1",
              "editorMode": "code"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "fahrenheit",
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 0,
                "showPoints": "auto",
                "pointSize": 4,
                "spanNulls": true,
                "lineInterpolation": "smooth"
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true,
              "calcs": [
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        }
      ],
      "id": 100
    }
  ],
  "description": "One collapsible section per company and site. Auburn WA hosts both Plymouth and S&J, so sections are keyed on company AND site -- a site manager never sees another company's equipment."
}