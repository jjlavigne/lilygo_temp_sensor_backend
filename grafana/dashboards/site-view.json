    {
      "id": 2,
      "title": "Need Attention",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cfmk49pm86epsf"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE t.recorded_at IS NULL\n      OR t.recorded_at < now() - (GREATEST(d.expected_interval_s*3,60)||' seconds')::interval\n      OR t.temperature_c > d.temp_max_c OR t.temperature_c < d.temp_min_c) AS needs_attention\nFROM devices d LEFT JOIN LATERAL (\n  SELECT temperature_c, battery_pct, recorded_at FROM telemetry\n  WHERE device_id = d.device_id ORDER BY recorded_at DESC LIMIT 1\n) t ON true WHERE d.is_active AND d.site IN (${site:sqlstring}) AND d.company IN (${company:sqlstring})",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "All OK",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Headroom \u2014 room left before each unit breaches",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cfmk49pm86epsf"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 14,
        "h": 9
      },
      "description": "Degrees between each unit's reading and the nearer of its two limits. Silent units are left out -- a stale reading says nothing about how much room a unit has now.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(d.display_name, d.device_id) AS device,\n  LEAST(d.temp_max_c - t.temperature_c, t.temperature_c - d.temp_min_c)*9.0/5.0 AS headroom\nFROM devices d LEFT JOIN LATERAL (\n  SELECT temperature_c, battery_pct, recorded_at FROM telemetry\n  WHERE device_id = d.device_id ORDER BY recorded_at DESC LIMIT 1\n) t ON true\nWHERE d.is_active AND d.site IN (${site:sqlstring}) AND d.company IN (${company:sqlstring}) AND t.recorded_at > now() - (GREATEST(d.expected_interval_s*3,60)||' seconds')::interval\nORDER BY 2 ASC",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "minVizWidth": 8,
        "maxVizHeight": 20,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 4,
      "title": "Every Unit Here",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cfmk49pm86epsf"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 10
      },
      "description": "Sorted so anything wrong is at the top. Click a device for its history.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(d.display_name, d.device_id) AS \"Device\",\n  d.company AS \"Company\",\n  CASE\n    WHEN t.recorded_at IS NULL THEN 'NEVER REPORTED'\n    WHEN t.recorded_at < now() - (GREATEST(d.expected_interval_s*3,60)||' seconds')::interval THEN 'OFFLINE'\n    WHEN t.temperature_c > d.temp_max_c THEN 'ABOVE THRESHOLD'\n    WHEN t.temperature_c < d.temp_min_c THEN 'BELOW THRESHOLD'\n    ELSE 'OK' END AS \"Condition\",\n  t.temperature_c*9.0/5.0+32 AS \"Reading\",\n  d.temp_min_c*9.0/5.0+32 AS \"Min OK\",\n  d.temp_max_c*9.0/5.0+32 AS \"Max OK\",\n  CASE WHEN t.recorded_at > now() - (GREATEST(d.expected_interval_s*3,60)||' seconds')::interval\n       THEN LEAST(d.temp_max_c - t.temperature_c,\n                  t.temperature_c - d.temp_min_c)*9.0/5.0 END AS \"Room Left\",\n  t.battery_pct AS \"Battery\",\n  t.recorded_at AS \"Last Seen\"\nFROM devices d LEFT JOIN LATERAL (\n  SELECT temperature_c, battery_pct, recorded_at FROM telemetry\n  WHERE device_id = d.device_id ORDER BY recorded_at DESC LIMIT 1\n) t ON true\nWHERE d.is_active AND d.site IN (${site:sqlstring}) AND d.company IN (${company:sqlstring})\nORDER BY CASE CASE\n    WHEN t.recorded_at IS NULL THEN 'NEVER REPORTED'\n    WHEN t.recorded_at < now() - (GREATEST(d.expected_interval_s*3,60)||' seconds')::interval THEN 'OFFLINE'\n    WHEN t.temperature_c > d.temp_max_c THEN 'ABOVE THRESHOLD'\n    WHEN t.temperature_c < d.temp_min_c THEN 'BELOW THRESHOLD'\n    ELSE 'OK' END\n           WHEN 'ABOVE THRESHOLD' THEN 1 WHEN 'BELOW THRESHOLD' THEN 2\n           WHEN 'OFFLINE' THEN 3 WHEN 'NEVER REPORTED' THEN 4 ELSE 5 END,\n         \"Room Left\" ASC NULLS FIRST",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No units registered at this site"
        },
