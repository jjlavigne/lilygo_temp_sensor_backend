      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(t.recorded_at, $__interval),\n  COALESCE(d.display_name, d.device_id) AS metric,\n  avg(t.temperature_c*9.0/5.0+32) AS temperature\nFROM telemetry t JOIN devices d ON d.device_id = t.device_id AND d.is_active\nWHERE $__timeFilter(t.recorded_at) AND d.site IN (${site:sqlstring}) AND d.company IN (${company:sqlstring})\nGROUP BY 1,2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Temperature",
      "type": "timeseries"
    }
