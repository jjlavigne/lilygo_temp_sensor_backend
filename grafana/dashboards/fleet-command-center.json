          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT DISTINCT ON (d.device_id)\n  d.company,\n  d.site,\n  d.device_id,\n  t.temperature_c,\n  d.temp_min_c   AS min_ok,\n  d.temp_max_c   AS max_ok,\n  t.battery_pct,\n  t.recorded_at  AS last_seen,\n  CASE\n    WHEN t.recorded_at IS NULL\n      OR t.recorded_at < now() - (GREATEST(d.expected_interval_s * 3, 60) || ' seconds')::interval\n      THEN 'OFFLINE'\n    WHEN t.temperature_c > d.temp_max_c THEN 'HIGH'\n    WHEN t.temperature_c < d.temp_min_c THEN 'LOW'\n    ELSE 'OK'\n  END AS status\nFROM devices d\nLEFT JOIN telemetry t ON t.device_id = d.device_id\n     AND t.recorded_at > now() - interval '6 hours'\nWHERE d.company IN (${company:sqlstring})\nORDER BY d.device_id, t.recorded_at DESC",
          "refId": "A"
        }
      ],
      "title": "Fleet Status",
      "type": "table"
    },
