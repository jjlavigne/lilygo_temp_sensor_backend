          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(d.display_name, d.device_id) AS device,\n  d.company,\n  100.0 * count(*) FILTER (\n      WHERE t.temperature_c BETWEEN d.temp_min_c AND d.temp_max_c\n  ) / count(*) AS in_range\nFROM telemetry t\nJOIN devices d ON d.device_id = t.device_id AND d.is_active\nWHERE t.recorded_at > now() - interval '7 days' AND d.company IN (${company:sqlstring})\nGROUP BY 1, 2\nORDER BY 3 ASC",
