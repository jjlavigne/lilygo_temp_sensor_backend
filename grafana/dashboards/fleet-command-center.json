      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  d.site AS location,\n  avg(t.latitude)  AS latitude,\n  avg(t.longitude) AS longitude,\n  count(*) AS units,\n  count(*) FILTER (WHERE t.recorded_at IS NULL OR t.recorded_at < now() - (GREATEST(d.expected_interval_s*3,60)||' seconds')::interval\n       OR t.temperature_c > d.temp_max_c OR t.temperature_c < d.temp_min_c) AS needs_attention,\n  d.site || ' \u2014 ' || CASE\n    WHEN count(*) FILTER (WHERE t.recorded_at IS NULL OR t.recorded_at < now() - (GREATEST(d.expected_interval_s*3,60)||' seconds')::interval\n       OR t.temperature_c > d.temp_max_c OR t.temperature_c < d.temp_min_c) = 0 THEN 'all ' || count(*) || ' OK'\n    ELSE count(*) FILTER (WHERE t.recorded_at IS NULL OR t.recorded_at < now() - (GREATEST(d.expected_interval_s*3,60)||' seconds')::interval\n       OR t.temperature_c > d.temp_max_c OR t.temperature_c < d.temp_min_c) || ' of ' || count(*) || ' need attention'\n  END AS label\nFROM devices d\nLEFT JOIN LATERAL (\n  SELECT temperature_c, recorded_at, latitude, longitude FROM telemetry\n  WHERE device_id = d.device_id ORDER BY recorded_at DESC LIMIT 1\n) t ON true\nWHERE d.is_active AND d.company IN (${company:sqlstring}) AND t.latitude IS NOT NULL\nGROUP BY d.site",
          "refId": "A"
        }
