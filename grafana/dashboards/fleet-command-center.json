          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (t.device_id)\n  COALESCE(d.display_name, t.device_id) AS device, t.battery_pct\nFROM telemetry t JOIN devices d ON d.device_id = t.device_id AND d.is_active\nWHERE t.recorded_at > now() - interval '30 minutes'\n  AND t.battery_pct IS NOT NULL AND d.company IN (${company:sqlstring})\nORDER BY t.device_id, t.recorded_at DESC",
