          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Reporting\" FROM (\n  SELECT d.device_id\n  FROM devices d\n  LEFT JOIN telemetry t ON t.device_id = d.device_id\n       AND t.recorded_at > now() - interval '6 hours'\n  WHERE d.company IN (${company:sqlstring})\n  GROUP BY d.device_id, d.expected_interval_s\n  HAVING EXTRACT(EPOCH FROM (now() - COALESCE(MAX(t.recorded_at), now() - interval '1 day')))\n         <= GREATEST(d.expected_interval_s * 3, 60)\n) x",
          "refId": "A"
        }
      ],
      "title": "Devices Reporting",
      "type": "stat"
    },
