      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  d.company || ' / ' || d.site AS location,\n  COALESCE(d.display_name, d.device_id) AS device,\n  CASE\n    WHEN t.recorded_at IS NULL THEN 'NEVER REPORTED'\n    WHEN t.recorded_at < now() - (GREATEST(d.expected_interval_s*3,60)||' seconds')::interval THEN 'OFFLINE'\n    WHEN t.temperature_c > d.temp_max_c THEN 'TOO WARM'\n    ELSE 'TOO COLD'\n  END AS problem,\n  t.temperature_c *9.0/5.0+32 AS reading,\n  GREATEST(t.temperature_c - d.temp_max_c, d.temp_min_c - t.temperature_c)*9.0/5.0 AS degrees_out,\n  t.recorded_at AS last_reading\nFROM devices d\nLEFT JOIN LATERAL (\n  SELECT temperature_c, recorded_at FROM telemetry\n  WHERE device_id = d.device_id ORDER BY recorded_at DESC LIMIT 1\n) t ON true\nWHERE d.is_active AND d.company IN (${company:sqlstring})\n  AND (t.recorded_at IS NULL\n       OR t.recorded_at < now() - (GREATEST(d.expected_interval_s*3,60)||' seconds')::interval\n       OR t.temperature_c > d.temp_max_c\n       OR t.temperature_c < d.temp_min_c)\nORDER BY 3, 5 DESC NULLS LAST",
          "refId": "A"
        }
      ],
      "title": "Needs Attention",
      "type": "table"
    },
