          "rawQuery": true,
          "rawSql": "SELECT\n  r.received_at AS \"time\",\n  COALESCE(d.display_name, r.device_id) AS device,\n  d.company,\n  r.reason\nFROM rejected_readings r\nLEFT JOIN devices d ON d.device_id = r.device_id\nWHERE r.received_at > now() - interval '7 days'\nORDER BY r.received_at DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
