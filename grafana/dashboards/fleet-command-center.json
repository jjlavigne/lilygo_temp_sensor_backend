          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"In excursion\" FROM (\n  SELECT DISTINCT ON (t.device_id) t.device_id,\n    GREATEST(t.temperature_c - d.temp_max_c,\n             d.temp_min_c - t.temperature_c) AS excursion_c\n  FROM telemetry t JOIN devices d USING (device_id)\n  WHERE t.recorded_at > now() - interval '30 minutes' AND d.company IN (${company:sqlstring})\n  ORDER BY t.device_id, t.recorded_at DESC\n) latest WHERE excursion_c > 0",
          "refId": "A"
        }
      ],
      "title": "Temperature Excursions",
      "type": "stat"
    },
