          "rawSql": "SELECT count(*) AS \"Low battery\" FROM (\n  SELECT DISTINCT ON (t.device_id) t.device_id, t.battery_pct\n  FROM telemetry t JOIN devices d USING (device_id)\n  WHERE t.recorded_at > now() - interval '30 minutes'\n    AND t.battery_pct IS NOT NULL AND d.company IN (${company:sqlstring})\n  ORDER BY t.device_id, t.recorded_at DESC\n) latest WHERE battery_pct < 20",
          "refId": "A"
        }
