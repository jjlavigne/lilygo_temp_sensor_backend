          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(d.display_name, d.device_id) AS \"Device\",\n  d.company AS \"Company\",\n  CASE WHEN count(*) FILTER (WHERE t.temperature_c NOT BETWEEN d.temp_min_c AND d.temp_max_c) = 0 THEN 100.0\n       ELSE LEAST(100.0 * count(*) FILTER (WHERE t.temperature_c BETWEEN d.temp_min_c AND d.temp_max_c) / count(*), 99.99) END AS \"In Range\"\nFROM telemetry t\nJOIN devices d ON d.device_id = t.device_id AND d.is_active\nWHERE t.recorded_at > now() - interval '$window' AND d.company IN (${company:sqlstring})\nGROUP BY 1, 2\nORDER BY 3 ASC",
          "refId": "A"
        }
      ],
      "title": "Stayed In Range \u2014 last $window",
      "type": "table"
