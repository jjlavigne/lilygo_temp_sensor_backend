          {
            "desc": false,
            "displayName": "Degrees From Limit"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \"Device\", \"Reading\", \"Nearest Limit\", \"Degrees From Limit\"\nFROM (\n  SELECT DISTINCT ON (t.device_id)\n    COALESCE(d.display_name, t.device_id) AS \"Device\",\n    t.temperature_c*9.0/5.0+32 AS \"Reading\",\n    CASE WHEN (d.temp_max_c - t.temperature_c) < (t.temperature_c - d.temp_min_c)\n         THEN d.temp_max_c ELSE d.temp_min_c END *9.0/5.0+32 AS \"Nearest Limit\",\n    LEAST(d.temp_max_c - t.temperature_c, t.temperature_c - d.temp_min_c)*9.0/5.0 AS \"Degrees From Limit\",\n    (d.temp_max_c - d.temp_min_c)*9.0/5.0 AS band_width\n  FROM telemetry t\n  JOIN devices d ON d.device_id = t.device_id AND d.is_active\n  WHERE t.recorded_at > now() - interval '30 minutes' AND d.company IN (${company:sqlstring})\n  ORDER BY t.device_id, t.recorded_at DESC\n) x\nWHERE \"Degrees From Limit\" >= 0 AND \"Degrees From Limit\" < 0.25 * band_width\nORDER BY \"Degrees From Limit\" ASC",
          "refId": "A"
        }
      ],
      "title": "Watch List \u2014 approaching their limits",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cfmk49pm86epsf"
      },
      "description": "Percentage of this week's readings that sat inside each unit's own limits. Uses today's limits, so changing a threshold re-scores the week.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
