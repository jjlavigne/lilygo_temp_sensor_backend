      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfmk49pm86epsf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  d.company,\n  d.site,\n  COALESCE(d.display_name, d.device_id) AS device,\n  t.temperature_c * 9.0/5.0 + 32 AS temperature,\n  d.temp_min_c * 9.0/5.0 + 32 AS min_ok,\n  d.temp_max_c * 9.0/5.0 + 32 AS max_ok,\n  t.battery_pct,\n  t.recorded_at AS last_seen,\n  CASE\n    WHEN t.recorded_at IS NULL THEN 'NEVER SEEN'\n    WHEN t.recorded_at < now() - (GREATEST(d.expected_interval_s * 3, 60) || ' seconds')::interval\n      THEN 'OFFLINE'\n    WHEN t.temperature_c > d.temp_max_c THEN 'HIGH'\n    WHEN t.temperature_c < d.temp_min_c THEN 'LOW'\n    ELSE 'OK'\n  END AS status\nFROM devices d\nLEFT JOIN LATERAL (\n  SELECT temperature_c, battery_pct, recorded_at\n  FROM telemetry WHERE device_id = d.device_id\n  ORDER BY recorded_at DESC LIMIT 1\n) t ON true\nWHERE d.company IN (${company:sqlstring})\nORDER BY d.company, COALESCE(d.display_name, d.device_id)",
          "refId": "A"
        }
      ],
      "title": "Fleet Status",
      "type": "table"
    },
