          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  d.company AS \"Company\",\n  d.site AS \"Site\",\n  COALESCE(d.display_name, d.device_id) AS \"Device\",\n  t.temperature_c * 9.0/5.0 + 32 AS \"Temperature\",\n  d.temp_min_c * 9.0/5.0 + 32 AS \"Min OK\",\n  d.temp_max_c * 9.0/5.0 + 32 AS \"Max OK\",\n  t.battery_pct AS \"Battery\",\n  t.recorded_at AS \"Last Seen\",\n  CASE\n    WHEN t.recorded_at IS NULL THEN 'NEVER REPORTED'\n    WHEN t.recorded_at < now() - (GREATEST(d.expected_interval_s*3,60)||' seconds')::interval THEN 'OFFLINE'\n    WHEN t.temperature_c > d.temp_max_c THEN 'ABOVE THRESHOLD'\n    WHEN t.temperature_c < d.temp_min_c THEN 'BELOW THRESHOLD'\n    ELSE 'OK'\n  END AS \"Condition\"\nFROM devices d\nLEFT JOIN LATERAL (\n  SELECT temperature_c, battery_pct, recorded_at\n  FROM telemetry WHERE d.is_active AND device_id = d.device_id\n  ORDER BY recorded_at DESC LIMIT 1\n) t ON true\nWHERE d.company IN (${company:sqlstring})\nORDER BY d.company, COALESCE(d.display_name, d.device_id)",
          "refId": "A"
        }
